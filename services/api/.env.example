# ============================================
# BACKEND CONFIGURATION (.env.local)
# ============================================

# ============================================
# SERVER
# ============================================
NODE_ENV=development
PORT=5000

# ============================================
# DATABASE (Firestore)
# ============================================
# Get your credentials from Firebase Console: https://console.firebase.google.com/
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_PRIVATE_KEY=your-private-key
FIREBASE_CLIENT_EMAIL=your-client-email@appspot.gserviceaccount.com

# Path to Firebase service account key JSON file (alternative to inline vars)
GOOGLE_APPLICATION_CREDENTIALS=/path/to/serviceAccountKey.json

# ============================================
# JWT SECRETS (CHANGE THESE IN PRODUCTION!)
# ============================================
# Generate random 32+ character strings
JWT_ACCESS_SECRET=your-access-secret-key-min-32-chars-change-in-production
JWT_REFRESH_SECRET=your-refresh-secret-key-min-32-chars-change-in-production

# ============================================
# GOOGLE OAUTH
# ============================================
# Get these from: https://console.cloud.google.com/
GOOGLE_CLIENT_ID=YOUR_CLIENT_ID.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=YOUR_CLIENT_SECRET

# ============================================
# CORS (Frontend URLs)
# ============================================
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:3001

# ============================================
# FRONTEND API URL (For redirects)
# ============================================
FRONTEND_URL=http://localhost:3000
VITE_API_URL=http://localhost:5000/api

# ============================================
# EMAIL SERVICE (For verification/password reset)
# ============================================
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-specific-password
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587

# ============================================
# LOGGING
# ============================================
LOG_LEVEL=debug
