# ============================================
# BACKEND CONFIGURATION (.env.local)
# ============================================

# ============================================
# SERVER
# ============================================
NODE_ENV=development
PORT=5000

# ============================================
# DATABASE (Firestore) - Mock/Development
# ============================================
# Get your credentials from Firebase Console: https://console.firebase.google.com/
FIREBASE_PROJECT_ID=agentic-restaurant-dev
FIREBASE_PRIVATE_KEY=dummy-key-for-development
FIREBASE_CLIENT_EMAIL=firebase-adminsdk@appspot.gserviceaccount.com

# Path to Firebase service account key JSON file (alternative to inline vars)
GOOGLE_APPLICATION_CREDENTIALS=

# ============================================
# JWT SECRETS (CHANGE THESE IN PRODUCTION!)
# ============================================
# Generate random 32+ character strings
JWT_ACCESS_SECRET=dev-access-secret-key-min-32-chars-change-in-production-12345678
JWT_REFRESH_SECRET=dev-refresh-secret-key-min-32-chars-change-in-production-12345678

# ============================================
# GOOGLE OAUTH
# ============================================
# Get these from: https://console.cloud.google.com/
GOOGLE_CLIENT_ID=dev_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=dev_client_secret

# ============================================
# CORS (Frontend URLs)
# ============================================
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5175,http://localhost:5176,http://localhost:5177,http://localhost:3000,http://localhost:3001,http://localhost:3002

# ============================================
# FRONTEND API URL (For redirects)
# ============================================
FRONTEND_URL=http://localhost:3000
VITE_API_URL=http://localhost:5000/api

# ============================================
# LOGGING
# ============================================
LOG_LEVEL=debug
